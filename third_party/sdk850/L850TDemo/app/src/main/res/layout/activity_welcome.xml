<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cls_luanch"
        android:layout_width="match_parent"
        android:background="@color/color_5F9EA0"
        android:visibility="visible"
        android:layout_height="match_parent">
        <ProgressBar
            android:id="@+id/pb_download"
            android:layout_width="0dp"
            app:layout_constraintWidth_percent="0.5"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="100dp"
            android:orientation="horizontal"
            android:max="100"
            android:progress="0"
            tools:progress="30"
            android:progressDrawable="@drawable/progress_download"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_height="40dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设备启动中"
            android:textColor="@color/white"
            android:textSize="40sp"
            app:layout_constraintLeft_toLeftOf="@id/pb_download"
            app:layout_constraintRight_toRightOf="@id/pb_download"
            app:layout_constraintTop_toBottomOf="@id/pb_download"
            android:layout_marginTop="30dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/llt_btns"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        android:layout_height="match_parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_traning"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/av_elastic"
            android:background="@drawable/selector_button_bg"
            android:layout_marginHorizontal="30dp"
            android:textSize="60sp"
            android:textColor="@color/white"
            android:layout_width="500dp"
            android:layout_height="300dp"
            android:layout_marginTop="30dp"
            android:text="运动界面" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_factory"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/av_elastic"
            android:background="@drawable/selector_button_bg"
            android:layout_marginHorizontal="30dp"
            android:textSize="60sp"
            android:textColor="@color/white"
            android:layout_width="500dp"
            android:layout_height="300dp"
            android:layout_marginTop="30dp"
            android:text="工厂模式" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_update"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/av_elastic"
            android:background="@drawable/selector_button_bg"
            android:layout_marginHorizontal="30dp"
            android:textSize="60sp"
            android:textColor="@color/white"
            android:layout_width="500dp"
            android:layout_height="300dp"
            android:layout_marginTop="30dp"
            android:text="OTA 更新" />
    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>