<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:ignore="PxUsage"
    android:layout_width="match_parent"
    android:background="@color/color_E2E2E2"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tv_tab_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="60dp"
        android:textColor="@color/black"
        android:textSize="60sp"
        android:text="@string/update_app"/>

    <TextView
        android:id="@+id/tv_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_tab_name"
        android:visibility="gone"
        android:layout_marginTop="20dp"
        android:textColor="@color/white"
        android:textSize="38sp"
        tools:text="Version V1.0.0.0.1"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cls_soft_number"
        android:layout_width="0dp"
        app:layout_constraintWidth_percent="0.4"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_version"
        android:layout_marginTop="60dp"
        android:layout_margin="40dp"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tv_soft_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            android:text="@string/update_software_number"
            android:textColor="@color/color_333"
            android:textSize="34sp"/>

        <TextView
            android:id="@+id/tv_soft_number_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:layout_gravity="right"
            android:textColor="@color/color_333"
            tools:text="1.0.0.0.1"
            android:textSize="34sp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cls_product_model"
        android:layout_width="0dp"
        app:layout_constraintWidth_percent="0.4"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cls_soft_number"
        android:layout_marginTop="60dp"
        android:layout_margin="40dp"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tv__product_model"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            android:text="@string/update_product_model"
            android:textColor="@color/color_333"
            android:textSize="34sp"/>

        <TextView
            android:id="@+id/tv_product_model_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:layout_gravity="right"
            android:textColor="@color/color_333"
            tools:text="1.0.0.0.1"
            android:textSize="34sp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cls_current"
        android:layout_width="0dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/cls_soft_number"
        app:layout_constraintTop_toBottomOf="@+id/tv_version"
        android:layout_marginTop="60dp"
        android:layout_marginLeft="100dp"
        android:layout_marginRight="40dp"
        android:layout_marginVertical="40dp"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tv_current_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            android:text="@string/update_current_version"
            android:textColor="@color/color_333"
            android:textSize="34sp"/>

        <TextView
            android:id="@+id/tv_current_version_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:layout_gravity="right"
            android:textColor="@color/color_333"
            tools:text="1.0.0.0.1"
            android:textSize="34sp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cls_last"
        android:layout_width="0dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/cls_product_model"
        app:layout_constraintTop_toBottomOf="@+id/cls_current"
        android:layout_marginTop="60dp"
        android:layout_marginStart="100dp"
        android:layout_marginRight="40dp"
        android:layout_marginVertical="40dp"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tv_last_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            android:text="@string/update_latest_version"
            android:textColor="@color/color_333"
            android:textSize="34sp"/>

        <TextView
            android:id="@+id/tv_latest_version_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:textColor="@color/color_333"
            tools:text="1.0.0.0.1"
            android:textSize="34sp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_revert"
        android:layout_width="wrap_content"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/cls_last"
        app:layout_constraintLeft_toLeftOf="parent"
        android:paddingHorizontal="50dp"
        android:layout_marginHorizontal="40dp"
        android:layout_marginTop="30dp"
        android:layout_height="90dp"
        android:text="@string/update_revert"
        android:textColor="@color/white"
        android:textSize="30sp"
        android:textAllCaps="false"
        android:background="@drawable/selector_button_bg"/>


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_check"
        android:layout_width="match_parent"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginHorizontal="40dp"
        android:layout_marginBottom="60dp"
        android:layout_height="114dp"
        android:text="@string/update_check_update"
        android:textColor="@color/white"
        android:textSize="38sp"
        android:textAllCaps="false"
        android:background="@drawable/selector_button_bg"/>

    <TextView
        android:id="@+id/tv_is_last_veriosn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/btn_check"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginHorizontal="40dp"
        android:layout_marginBottom="40dp"
        android:text="@string/update_is_last_version"
        android:textSize="30sp"
        android:textColor="@color/white"/>

    <ProgressBar
        android:id="@+id/pb_download"
        android:layout_width="match_parent"
        app:layout_constraintBottom_toTopOf="@+id/tv_download_tip"
        android:layout_marginBottom="40dp"
        android:layout_marginHorizontal="40dp"
        android:orientation="horizontal"
        android:visibility="gone"
        android:max="100"
        android:progress="0"
        tools:progress="30"
        android:progressDrawable="@drawable/progress_download"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_height="20dp"/>

    <ProgressBar
        android:id="@+id/pb_install"
        android:layout_width="60dp"
        app:layout_constraintTop_toTopOf="@+id/tv_download_tip"
        app:layout_constraintBottom_toBottomOf="@+id/tv_download_tip"
        app:layout_constraintRight_toLeftOf="@+id/tv_download_tip"
        android:layout_marginRight="20dp"
        android:visibility="gone"
        android:indeterminateTint="@color/color_333"
        android:layout_height="60dp"/>


    <TextView
        android:id="@+id/tv_download_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/btn_check"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:paddingHorizontal="40dp"
        android:layout_marginBottom="60dp"
        android:visibility="gone"
        android:text="@string/update_downloading"
        android:textSize="30sp"
        android:textColor="@color/color_333"/>

</androidx.constraintlayout.widget.ConstraintLayout>