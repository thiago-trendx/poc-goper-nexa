<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 第一层：进度条背景（直接嵌套shape，无需单独文件） -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <!-- 背景色 -->
            <solid android:color="#32FFFFFF" />
            <!-- 圆角（与进度条高度一致，实现胶囊状） -->
            <corners android:radius="10dp"/>
            <!-- 进度条高度（布局中height需匹配此值） -->
            <size android:height="20dp" />
        </shape>
    </item>

    <!-- 第二层：进度条进度（clip控制显示范围，嵌套渐变shape） -->
    <item android:id="@android:id/progress">
        <clip
            android:clipOrientation="horizontal"
            android:gravity="left">
            <shape android:shape="rectangle">
                <!-- 渐变进度色（也可改为solid纯色） -->
                <!--<gradient
                    android:angle="0"
                    android:endColor="@color/color_3D75F0"
                    android:startColor="@color/color_3D75F0" />-->

                <solid android:color="@color/color_008B8B" />
                <!-- 圆角与背景一致，避免错位 -->
                <corners android:radius="10dp"/>
                <size android:height="20dp" />
            </shape>
        </clip>
    </item>
</layer-list>